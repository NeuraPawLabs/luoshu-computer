{
  "name": "@luoshu/worker",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    },
    "./executor": {
      "types": "./dist/executor.d.ts",
      "import": "./dist/executor.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "import": "./dist/codex.js"
    }
  },
  "bin": {
    "luoshu-worker": "dist/main.js",
    "luoshu-computer": "dist/computer-main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc -b --pretty false",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
