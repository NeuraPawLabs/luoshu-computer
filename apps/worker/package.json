  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.5.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "references": [
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/config"
    }
